<mxfile host="app.diagrams.net">
  <diagram name="Decision Flow: Advance vs Regress">
    <mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="start" value="判断対象の技術機能&#xa;高度化するか／縮退させるか" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="340" y="40" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="q1" value="失敗が不可逆か&#xa;（人命・法的責任・高額損失）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="150" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="q2" value="ネットワーク同期が&#xa;本質要件か" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="300" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="q3" value="lock-in が強く&#xa;移行経路に乏しいか" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="450" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="q4" value="自動化で skill decay や&#xa;out-of-the-loop が起きるか" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="600" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="regress" value="縮退レーン&#xa;&#xa;• human-in-the-loop&#xa;• フェイルセーフ・可観測性&#xa;• local-first / graceful degradation&#xa;• portability・脱 lock-in&#xa;• repairability・技能継承" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="780" width="280" height="180" as="geometry" />
        </mxCell>

        <mxCell id="advance" value="高度化レーン&#xa;&#xa;• full automation / agent&#xa;• cloud-native 同期&#xa;• 高頻度更新・パーソナライズ&#xa;• 速度・統合性が顧客価値&#xa;• 監査ログ完備で可逆" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="780" width="280" height="180" as="geometry" />
        </mxCell>

        <mxCell id="caption" value="出典: Google SRE / EU AI Act Article 14 / Bainbridge 1983 / Ink &amp; Switch local-first / JFTC&#xa;図中の質問順序は recoverability → coupling → portability → human skill" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="100" y="1000" width="720" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" source="start" target="q1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e1y" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;fontSize=11;fontStyle=1;" edge="1" source="q1" target="regress" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e1n" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontStyle=1;" edge="1" source="q1" target="q2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2y" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;fontSize=11;fontStyle=1;" edge="1" source="q2" target="advance" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2n" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontStyle=1;" edge="1" source="q2" target="q3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3y" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;fontSize=11;fontStyle=1;" edge="1" source="q3" target="regress" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3n" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontStyle=1;" edge="1" source="q3" target="q4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e4y" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;fontSize=11;fontStyle=1;" edge="1" source="q4" target="regress" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e4n" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;fontSize=11;fontStyle=1;" edge="1" source="q4" target="advance" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
