<mxfile host="app.diagrams.net">
  <diagram id="rag-cag-hybrid" name="RAG + CAG Hybrid Architecture">
    <mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="100" value="Hybrid: retrieval + context + cache の 3 層構成" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="20" width="580" height="36" as="geometry" />
        </mxCell>
        <mxCell id="user" value="ユーザークエリ&#10;(user id, session, role)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="430" y="80" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ctx" value="Context Manager&#10;&#10;・ロール / 権限 / 部門&#10;・セッション履歴&#10;・業務状態 / ポリシー" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="380" y="180" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rag" value="RAG パス&#10;(大規模 / 動的 / ACL 制約)&#10;&#10;・ベクトル索引&#10;・namespace / metadata filter&#10;・リランカー" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="340" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="cag" value="Cache-CAG パス&#10;(有限 / 安定 / 高頻度)&#10;&#10;・事前ロード済みコーパス&#10;・KV キャッシュ&#10;・コーパス版数管理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="740" y="340" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="assemble" value="プロンプト組み立て&#10;(source ids を保持してエビデンスを並置)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad7ac;strokeColor=#b46504;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="330" y="540" width="440" height="64" as="geometry" />
        </mxCell>
        <mxCell id="prefix" value="安定プレフィックスは&#10;Provider Prompt / KV Cache&#10;(OpenAI / Anthropic / Google)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=2;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="800" y="540" width="240" height="64" as="geometry" />
        </mxCell>
        <mxCell id="llm" value="LLM 生成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="430" y="660" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="resp" value="回答 (provenance / citation 付き)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="380" y="760" width="340" height="50" as="geometry" />
